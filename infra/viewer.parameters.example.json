    "w365TenantId": { "value": "YOUR-W365-TENANT-ID" },
    "blueprintId": { "value": "YOUR-W365-BLUEPRINT-APP-ID" },
    "agentId": { "value": "YOUR-W365-AGENT-ID" },
    "agentObjectId": { "value": "YOUR-FOUNDRY-AGENT-OBJECT-ID" },
    "agentUserId": { "value": "YOUR-W365-AGENT-USER-OBJECT-ID" },
    "screenShareSdkUrl": { "value": "https://YOUR-ONBOARDING-HOST/sdk.js" },
    "screenShareFrameOrigins": { "value": "https://YOUR-ONBOARDING-FRAME-HOST" },
    "screenShareAppUrl": { "value": "https://YOUR-W365-SCREENSHARE-APP-HOST" }
  }
}
