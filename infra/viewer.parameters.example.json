{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "win365-viewer" },
    "managedEnvironmentResourceId": { "value": "/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-SHARED-RG/providers/Microsoft.App/managedEnvironments/YOUR-ENVIRONMENT" },
    "registryName": { "value": "YOUR-EXISTING-ACR" },
    "imageName": { "value": "win365-sample:v1" },
    "keyVaultName": { "value": "YOUR-EXISTING-VAULT" },
    "w365Enabled": { "value": false },
    "oidcSecretName": { "value": "w365-viewer-client-secret" },
    "blueprintSecretName": { "value": "w365-blueprint-client-secret" },
    "blueprintCredentialMode": { "value": "client_secret" },
    "sessionBlobUri": { "value": "https://YOUR-EXISTING-STORAGE.blob.core.windows.net/desktop-state/slot.json" },
    "viewerPublicUrl": { "value": "https://YOUR-VIEWER-HOST" },
    "viewerClientId": { "value": "YOUR-OIDC-WEB-APP-CLIENT-ID" },
