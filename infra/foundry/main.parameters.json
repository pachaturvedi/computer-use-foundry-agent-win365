{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "foundryResourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "accountName": { "value": "${AZURE_AI_ACCOUNT_NAME}" },
    "projectName": { "value": "${AZURE_AI_PROJECT_NAME}" },
    "resourcePrefix": { "value": "${RESOURCE_PREFIX}" },
    "modelDeploymentName": { "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME}" },
    "modelName": { "value": "${FOUNDRY_MODEL_NAME}" },
    "modelVersion": { "value": "${FOUNDRY_MODEL_VERSION}" },
    "modelSkuName": { "value": "${FOUNDRY_MODEL_SKU_NAME}" },
    "modelSkuCapacity": { "value": "${FOUNDRY_MODEL_SKU_CAPACITY}" },
    "foundryProjectOwnership": { "value": "${FOUNDRY_PROJECT_OWNERSHIP=managed}" },
    "existingProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "existingProjectId": { "value": "${AZURE_AI_PROJECT_ID}" },
    "existingFoundryResourceGroupId": { "value": "${AZD_FOUNDRY_RESOURCE_GROUP_ID}" },
    "existingFoundryResourceGroupName": { "value": "${AZURE_FOUNDRY_RESOURCE_GROUP}" }
  }
}