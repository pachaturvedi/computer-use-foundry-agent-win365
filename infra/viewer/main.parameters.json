{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "deployViewer": { "value": "${DEPLOY_VIEWER=false}" },
    "deployState": { "value": "${DEPLOY_STATE=false}" },
    "viewerProvisioningActive": { "value": "${VIEWER_PROVISIONING_ACTIVE=false}" },
    "w365Enabled": { "value": "${W365_ENABLED=false}" },
    "resourcePrefix": { "value": "${RESOURCE_PREFIX=}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=}" },
    "viewerImageName": { "value": "${VIEWER_IMAGE_NAME=win365-sample:v1}" },
    "viewerManagedEnvironmentResourceId": { "value": "${VIEWER_MANAGED_ENVIRONMENT_RESOURCE_ID=}" },
    "viewerLogAnalyticsEnabled": { "value": "${VIEWER_LOG_ANALYTICS_ENABLED=false}" },
    "w365KeyVaultName": { "value": "${W365_KEY_VAULT_NAME=}" },
    "viewerLiveEnabled": { "value": "${VIEWER_LIVE_ENABLED=false}" },
    "viewerPublicUrl": { "value": "${VIEWER_PUBLIC_URL=}" },
    "viewerClientId": { "value": "${VIEWER_CLIENT_ID=}" },
    "operatorTenantId": { "value": "${OPERATOR_TENANT_ID=}" },
    "operatorObjectId": { "value": "${OPERATOR_OBJECT_ID=}" },
    "stateStorageAccountName": { "value": "${STATE_STORAGE_ACCOUNT_NAME=}" },
    "stateContainerName": { "value": "${STATE_CONTAINER_NAME=}" },
    "sessionBlobUri": { "value": "${SESSION_BLOB_URI=}" },
    "w365TenantId": { "value": "${W365_TENANT_ID=}" },
    "blueprintId": { "value": "${W365_BLUEPRINT_ID=}" },
    "agentId": { "value": "${W365_AGENT_ID=}" },
    "agentObjectId": { "value": "${W365_AGENT_OBJECT_ID=}" },
    "agentUserId": { "value": "${W365_AGENT_USER_ID=}" },
    "blueprintCredentialMode": { "value": "${W365_BLUEPRINT_CREDENTIAL_MODE=key_vault_certificate}" },
    "certificateProvisioningActive": { "value": "${W365_CERTIFICATE_PROVISIONING_ACTIVE=false}" },
    "screenShareSdkUrl": { "value": "${SCREENSHARE_SDK_URL=}" },
    "screenShareFrameOrigins": { "value": "${SCREENSHARE_FRAME_ORIGINS=}" },
    "screenShareAppUrl": { "value": "${SCREENSHARE_APP_URL=}" }
  }
}
