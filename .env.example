# Local bootstrap only: Run-Local.ps1 loads this without executing expressions.
# Real W365 uses the deployed Foundry identity, not an az login user or a certificate.
SAMPLE_LOCAL_MODE=true
W365_ENABLED=false
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt.6.astra

# Phase 2: set these as azd env values after phase 1 and Setup-W365.ps1.
# Never enable W365 in local mode. Use the same existing Foundry agent on redeploy.
# W365_ENABLED=true
# W365_TENANT_ID=<same tenant as Foundry and viewer UAMI>
# W365_BLUEPRINT_ID=<existing Foundry blueprint client/app ID>
# W365_AGENT_ID=<existing Foundry agent client/app ID>
# W365_AGENT_OBJECT_ID=<existing Foundry agent object/principal ID>
# W365_AGENT_USER_ID=<agent user created/reused in phase 2>
# SESSION_BLOB_URI=https://YOUR-STORAGE.blob.core.windows.net/desktop-state/slot.json
# OPERATOR_TENANT_ID=<human viewer operator tenant>
# OPERATOR_OBJECT_ID=<human viewer operator object ID>
# HOSTED_ALLOWED_USER_ID=pending
# VIEWER_PUBLIC_URL=https://YOUR-VIEWER-HOST

# Viewer-only settings in infra/viewer.parameters.example.json:
# SCREENSHARE_SDK_URL=https://YOUR-ONBOARDING-HOST/sdk.js
# SCREENSHARE_FRAME_ORIGINS=https://YOUR-ONBOARDING-FRAME-HOST
# VIEWER_CLIENT_ID=<separate OIDC web application>
# VIEWER_CLIENT_SECRET=<Key Vault reference for OIDC only>
# AZURE_CLIENT_ID=<viewer UAMI client ID, set by Bicep>
# FOUNDRY_AGENT_BLUEPRINT_CLIENT_ID is platform-owned: never configure it yourself.
