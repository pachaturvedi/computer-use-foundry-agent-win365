# Copy to .env; Run-Local.ps1 loads it without executing shell expressions.
# Existing process environment overrides .env. Keep secrets in dotnet user-secrets.
SAMPLE_LOCAL_MODE=true
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
# Recommended model: gpt.6.astra. Use YOUR actual deployment name; availability varies.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt.6.astra

# Printed by scripts\Setup-W365.ps1
W365_TENANT_ID=
W365_BLUEPRINT_ID=
W365_AGENT_ID=
W365_AGENT_USER_ID=
W365_CERTIFICATE_PATH=.local\blueprint.pfx
# Set W365_CERTIFICATE_PASSWORD in user-secrets. Never use a blueprint secret.

# Human operator, NOT the agent user. These may belong to a different tenant from W365.
OPERATOR_TENANT_ID=
OPERATOR_OBJECT_ID=
SESSION_FILE=.local\desktop-session.json
VIEWER_PUBLIC_URL=http://localhost:5050
# Get the exact SDK bundle URL and iframe origins from W365 onboarding.
SCREENSHARE_SDK_URL=https://YOUR-ONBOARDING-HOST/sdk.js
SCREENSHARE_FRAME_ORIGINS=https://YOUR-ONBOARDING-FRAME-HOST

# Hosted configuration only (see docs\DEPLOYMENT.md):
# SAMPLE_LOCAL_MODE=false
# HOSTED_ALLOWED_USER_ID=<opaque platform-injected x-agent-user-id for the operator>
# SESSION_BLOB_URI=https://YOUR-STORAGE.blob.core.windows.net/desktop-state/slot.json
# W365_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net
# W365_CERTIFICATE_SECRET_NAME=w365-blueprint
# VIEWER_CLIENT_ID=<separate single-tenant OIDC web application>
# VIEWER_CLIENT_SECRET=<secret reference in ACA, never literal in manifests>
# AZURE_CLIENT_ID=<viewer UAMI client ID; omit for Foundry's platform credential>
